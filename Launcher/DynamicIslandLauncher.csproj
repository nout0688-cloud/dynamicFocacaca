<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DynamicIslandLauncher</RootNamespace>
    <AssemblyName>DynamicIslandLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <None Update="..\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\Services\SettingsService.cs" Link="SettingsService.cs" />
  </ItemGroup>

</Project>
