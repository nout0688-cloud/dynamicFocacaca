<Window x:Class="DynamicIslandLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Launcher"
        Width="700" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IOSFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Segmented Control Item Style -->
        <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="{StaticResource IOSFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="segBorder" Background="Transparent" CornerRadius="12" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Ambient Glow & Border -->
    <Border Margin="16" CornerRadius="28" Background="#E6121215"
            BorderBrush="#25FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- 0: Window Header -->
                <RowDefinition Height="56"/>
                <!-- 1: Wizard Stepper -->
                <RowDefinition Height="46"/>
                <!-- 2: Wizard Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Specular Highlight Line (Liquid Glass effect) -->
            <Border Grid.Row="0" Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="28,0,28,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 0. Header (Title + Window Buttons) -->
            <Grid Grid.Row="0" Margin="24,0,20,0" VerticalAlignment="Center">
                <!-- Left: Mini Dynamic Island Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="18" CornerRadius="9" Background="#000000" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="4" Fill="#30D158" Margin="0,0,3,0"/>
                            <Ellipse Width="3" Height="3" Fill="#0A84FF"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Dynamic Island" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#200A84FF" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="iOS 26" Foreground="#0A84FF" FontSize="10.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right: Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Minimize -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="26" Height="26" CornerRadius="13" Background="#15FFFFFF">
                                    <Path Data="M6 13h14" Stroke="#8E8E93" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#25FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Close -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="26" Height="26" CornerRadius="13" Background="#15FFFFFF">
                                    <Path Data="M7 7l12 12M19 7l-12 12" Stroke="#8E8E93" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#40FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Wizard Stepper Bar -->
            <Grid Grid.Row="1" Margin="24,0,24,0" VerticalAlignment="Center">
                <Border Background="#12FFFFFF" CornerRadius="15" Padding="4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="StepPill1" Background="#280A84FF" CornerRadius="12" Padding="14,5" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepDot1" Width="7" Height="7" Fill="#0A84FF" Margin="0,0,7,0"/>
                                <TextBlock x:Name="StepLabel1" Text="1. Ласкаво просимо" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="StepPill2" Background="Transparent" CornerRadius="12" Padding="14,5" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepDot2" Width="7" Height="7" Fill="#636366" Margin="0,0,7,0"/>
                                <TextBlock x:Name="StepLabel2" Text="2. Установка" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="StepPill3" Background="Transparent" CornerRadius="12" Padding="14,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepDot3" Width="7" Height="7" Fill="#636366" Margin="0,0,7,0"/>
                                <TextBlock x:Name="StepLabel3" Text="3. Налаштування" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Wizard Pages Container -->
            <Grid Grid.Row="2" Margin="24,10,24,24">

                <!-- ════════════════ PAGE 1: WELCOME ════════════════ -->
                <Grid x:Name="WelcomePage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Island Mockup & Title -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,16">
                        <!-- Floating Island Graphic -->
                        <Border Width="220" Height="40" CornerRadius="20" Background="#000000" BorderBrush="#25FFFFFF" BorderThickness="1"
                                Margin="0,0,0,14" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Grid Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Mini art -->
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#0A84FF">
                                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Title -->
                                <TextBlock Grid.Column="1" Text="Blinding Lights" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                <!-- Audio bars -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="2.5" Height="10" Background="#30D158" CornerRadius="1.25" Margin="1,0"/>
                                    <Border Width="2.5" Height="16" Background="#30D158" CornerRadius="1.25" Margin="1,0"/>
                                    <Border Width="2.5" Height="8" Background="#30D158" CornerRadius="1.25" Margin="1,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Dynamic Island для Windows" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Преміальний досвід iOS на вашому робочому столі" Foreground="#8E8E93" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 3 Feature Glass Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Margin="0,0,6,0" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#20FF375F" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Fill="#FF375F" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Медіаплеєр" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Spotify, YouTube та браузери з анімаціями та спектром звуку." Foreground="#8E8E93" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Margin="4,0,4,0" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#202AABEE" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M20 15.5c-1.25 0-2.45-.2-3.57-.57-.35-.11-.74-.03-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.21c.28-.27.36-.66.25-1.01A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"
                                          Fill="#2AABEE" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Дзвінки Telegram" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Швидка відповідь, скидання та керування мікрофоном." Foreground="#8E8E93" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Margin="6,0,0,0" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#2030D158" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                          Fill="#30D158" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Сповіщення" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Стильні прев'ю повідомлень Windows без настирливих тостів." Foreground="#8E8E93" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Action Button -->
                    <Button Grid.Row="2" Style="{StaticResource CupertinoPrimaryButton}" Content="Почати встановлення →" Click="StartInstall_Click"/>
                </Grid>

                <!-- ════════════════ PAGE 2: INSTALLATION ════════════════ -->
                <Grid x:Name="InstallPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                        <TextBlock Text="Встановлення Dynamic Island" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Розгортання системних компонентів та шрифтів" Foreground="#8E8E93" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Main Installation Card -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Progress Card -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="InstallStatusText" Text="Підготовка до встановлення..." Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InstallPercentText" Text="0%" Foreground="#0A84FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Liquid Progress Bar -->
                                <Border Height="10" Background="#20FFFFFF" CornerRadius="5">
                                    <Border x:Name="ProgressBarFill" Width="0" HorizontalAlignment="Left" Background="#0A84FF" CornerRadius="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#0A84FF" Opacity="0.5"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>

                                <TextBlock x:Name="InstallDetailText" Text="Розпакування та перевірка файлів..." Foreground="#636366" FontSize="11.5" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Style="{StaticResource GlassPanelStyle}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Автозапуск разом із Windows" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Dynamic Island вмикатиметься автоматично при вході в систему" Foreground="#8E8E93" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource CupertinoToggleSwitch}" IsChecked="True"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Action Button -->
                    <Button x:Name="ContinueToSettingsBtn" Grid.Row="2" Style="{StaticResource CupertinoPrimaryButton}" Content="Перейти до налаштувань →" IsEnabled="False" Click="GoToSettings_Click"/>
                </Grid>

                <!-- ════════════════ PAGE 3: SETTINGS ════════════════ -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Налаштування Dynamic Island" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Зміни застосовуються в реальному часі" Foreground="#8E8E93" FontSize="12.5" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Scrollable Settings Group -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,12" Padding="0,0,8,0">
                        <StackPanel>

                            <!-- 1. Розміщення (Positioning) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="РОЗМІЩЕННЯ НА ЕКРАНІ" Foreground="#636366" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    
                                    <!-- Horizontal Segmented Buttons -->
                                    <Border Background="#12FFFFFF" CornerRadius="14" Padding="3" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="AlignLeftRadio" Content="Ліворуч" Style="{StaticResource SegmentedRadioButton}" Checked="Alignment_Checked"/>
                                            <RadioButton x:Name="AlignCenterRadio" Content="По центру" Style="{StaticResource SegmentedRadioButton}" IsChecked="True" Checked="Alignment_Checked"/>
                                            <RadioButton x:Name="AlignRightRadio" Content="Праворуч" Style="{StaticResource SegmentedRadioButton}" Checked="Alignment_Checked"/>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Top Offset Slider -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Відступ від верху" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TopOffsetValText" Text="8 px" Foreground="#0A84FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TopOffsetSlider" Style="{StaticResource CupertinoSlider}" Minimum="0" Maximum="50" Value="8" ValueChanged="TopOffsetSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Розмір острова (Scale) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="МАСШТАБ ОСТРОВА" Foreground="#636366" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Розмір інтерфейсу" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ScaleValText" Text="100%" Foreground="#0A84FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource CupertinoSlider}" Minimum="80" Maximum="130" Value="100" ValueChanged="ScaleSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Тема (Theme) -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ТЕМА ТА ОФОРМЛЕННЯ" Foreground="#636366" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Border Background="#12FFFFFF" CornerRadius="14" Padding="3" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="ThemeDarkRadio" Content="Темна (OLED)" Style="{StaticResource SegmentedRadioButton}" IsChecked="True" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeLightRadio" Content="Світла" Style="{StaticResource SegmentedRadioButton}" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeSystemRadio" Content="Системна" Style="{StaticResource SegmentedRadioButton}" Checked="Theme_Checked"/>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Accent Color Selection -->
                                    <TextBlock Text="Акцентний колір" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="28" Height="28" Margin="0,0,10,0" Tag="#0A84FF" Click="AccentColor_Click">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="#0A84FF" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="28" Height="28" Margin="0,0,10,0" Tag="#30D158" Click="AccentColor_Click">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="#30D158" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="28" Height="28" Margin="0,0,10,0" Tag="#BF5AF2" Click="AccentColor_Click">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="#BF5AF2" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="28" Height="28" Margin="0,0,10,0" Tag="#FF9F0A" Click="AccentColor_Click">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="#FF9F0A" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="28" Height="28" Tag="#FF453A" Click="AccentColor_Click">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="#FF453A" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. Автозапуск -->
                            <Border Style="{StaticResource GlassPanelStyle}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Автозапуск при старті Windows" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Запускати острівець разом із операційною системою" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SettingsAutoStartCheck" Grid.Column="1" Style="{StaticResource CupertinoToggleSwitch}"
                                              Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Buttons Bar -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Open Folder -->
                        <Button Grid.Column="0" Style="{StaticResource CupertinoSecondaryButton}" Content="📁 Відкрити теку" Click="OpenFolder_Click"/>

                        <!-- Launch / Restart Dynamic Island -->
                        <Button Grid.Column="2" Style="{StaticResource CupertinoPrimaryButton}" Content="🚀 Запустити Dynamic Island" Click="RestartIsland_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
