<Window x:Class="DynamicIslandLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування"
        Width="520" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IOSFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Segmented Radio Button (iOS 26 Style) -->
        <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="{StaticResource IOSFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="segBorder" Background="Transparent" CornerRadius="7" Padding="10,5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#636366"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin iOS ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="#40FFFFFF" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main iPhone Silhouette Window Frame -->
    <Border Margin="14" CornerRadius="30" Background="#000000"
            BorderBrush="#2C2C2E" BorderThickness="1.2" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="45" ShadowDepth="12" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- 0: iOS Navigation Bar -->
                <RowDefinition Height="52"/>
                <!-- 1: Settings Scroll Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. Top iOS Navigation Bar (Draggable) -->
            <Grid Grid.Row="0" Margin="20,0,16,0" VerticalAlignment="Center">
                <!-- Left: Dynamic Island Status Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="14" CornerRadius="7" Background="#1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="0.8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="#30D158" Margin="0,0,2,0"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#0A84FF"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Dynamic Island" Foreground="#8E8E93" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Minimize Button -->
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="26" Height="26" CornerRadius="13" Background="#1C1C1E">
                                    <Path Data="M7 13h12" Stroke="#8E8E93" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2C2C2E"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#40FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Close Button -->
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="26" Height="26" CornerRadius="13" Background="#1C1C1E">
                                    <Path Data="M7 7l12 12M19 7l-12 12" Stroke="#8E8E93" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#40FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Scrollable Settings Content (Authentic iOS Inset Grouped Table View) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,2,8" Padding="0,0,6,0">
                <StackPanel Margin="16,0,16,16">

                    <!-- Large Title: Налаштування -->
                    <TextBlock Text="Налаштування" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" Margin="4,4,4,12"/>

                    <!-- iOS Search Bar (Decorative) -->
                    <Border Background="#1C1C1E" CornerRadius="10" Height="36" Margin="0,0,0,16" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="#8E8E93" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Пошук" Foreground="#8E8E93" FontSize="14" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Apple ID Style Profile / Product Card -->
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,20" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar / Icon: Glowing Dynamic Island -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#121214" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="14" CornerRadius="7" Background="#000000" BorderBrush="#30FFFFFF" BorderThickness="0.8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="3.5" Height="3.5" Fill="#30D158" Margin="0,0,2.5,0"/>
                                            <Ellipse Width="3" Height="3" Fill="#0A84FF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Text Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Dynamic Island Pro" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Apple iOS інтерфейс для Windows" Foreground="#8E8E93" FontSize="12.5" Margin="0,2,0,0"/>
                                <TextBlock Text="v2.0 • GitHub синхронізація" Foreground="#30D158" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Right Chevron -->
                            <TextBlock Grid.Column="2" Text="›" Foreground="#636366" FontSize="24" VerticalAlignment="Center" Margin="0,-4,4,0"/>
                        </Grid>
                    </Border>

                    <!-- ══════════ SECTION 1: ОНОВЛЕННЯ ТА ВСТАНОВЛЕННЯ ══════════ -->
                    <TextBlock Text="ОНОВЛЕННЯ ТА ВСТАНОВЛЕННЯ" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="14,0,14,6"/>
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,18" Padding="14,12">
                        <StackPanel>
                            <!-- Main Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon: Blue Squircle Cloud -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#0A84FF" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallStatusTitle" Text="Встановлення з GitHub" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InstallStatusSubText" Text="Версія 2.0 (36.5 МБ) • Репозиторій GitHub" Foreground="#8E8E93" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action Button -->
                                <Button x:Name="InstallActionButton" Grid.Column="2" Style="{StaticResource CupertinoPrimaryButton}"
                                        Height="32" Padding="14,0" FontSize="12.5" Content="Встановити →" Click="StartInstall_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Progress Container (Visible during download/install) -->
                            <StackPanel x:Name="InstallProgressGrid" Visibility="Collapsed" Margin="42,10,0,2">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="InstallDetailText" Text="Завантаження пакету з GitHub..." Foreground="#8E8E93" FontSize="11.5"/>
                                    <TextBlock x:Name="InstallPercentText" Text="0%" Foreground="#0A84FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Liquid Blue Progress Track -->
                                <Border Height="6" Background="#39393D" CornerRadius="3">
                                    <Border x:Name="ProgressBarFill" Width="0" Height="6" HorizontalAlignment="Left" Background="#0A84FF" CornerRadius="3"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══════════ SECTION 2: РОЗМІЩЕННЯ НА ЕКРАНІ ══════════ -->
                    <TextBlock Text="РОЗМІЩЕННЯ НА ЕКРАНІ" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="14,0,14,6"/>
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Row 1: Alignment (Segmented Control) -->
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Green Squircle Screen -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#30D158" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h6l-2 2v1h8v-1l-2-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Положення" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- iOS Segmented Control -->
                                <Border Grid.Column="2" Background="#121214" CornerRadius="8" Padding="2">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="AlignLeftRadio" Content="Ліворуч" Style="{StaticResource SegmentedRadioButton}" Checked="Alignment_Checked"/>
                                        <RadioButton x:Name="AlignCenterRadio" Content="По центру" Style="{StaticResource SegmentedRadioButton}" IsChecked="True" Checked="Alignment_Checked"/>
                                        <RadioButton x:Name="AlignRightRadio" Content="Праворуч" Style="{StaticResource SegmentedRadioButton}" Checked="Alignment_Checked"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="0.5" Background="#2C2C2E" Margin="52,0,0,0"/>

                            <!-- Row 2: Top Offset Slider -->
                            <Grid Margin="14,10,14,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Orange Squircle Arrows -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#FF9F0A" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M12 3l4 4h-3v10h3l-4 4-4-4h3V7H8l4-4z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Відступ від верху" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TopOffsetValText" Grid.Column="2" Text="8 px" Foreground="#0A84FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Slider Row -->
                            <Slider x:Name="TopOffsetSlider" Style="{StaticResource CupertinoSlider}"
                                    Minimum="0" Maximum="50" Value="8" Margin="52,0,14,12" ValueChanged="TopOffsetSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>
                    <!-- Explanatory footer -->
                    <TextBlock Text="Визначає позиціонування та верхній відступ Dynamic Island на моніторі." Foreground="#636366" FontSize="11.5" Margin="14,0,14,18"/>

                    <!-- ══════════ SECTION 3: МАСШТАБ ══════════ -->
                    <TextBlock Text="МАСШТАБ ТА РОЗМІР" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="14,0,14,6"/>
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Row 1: Scale Title & Value -->
                            <Grid Margin="14,10,14,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Purple Squircle Zoom -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#BF5AF2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M15 3l2.3 2.3-3.89 3.89 1.41 1.41L18.7 6.7 21 9V3h-6zM3 9l2.3-2.3 3.89 3.89 1.41-1.41L6.7 5.3 9 3H3v6zm6 12l-2.3-2.3 3.89-3.89-1.41-1.41L5.3 17.3 3 15v6h6zm12-6l-2.3 2.3-3.89-3.89-1.41 1.41 3.89 3.89L15 21h6v-6z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Розмір інтерфейсу" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScaleValText" Grid.Column="2" Text="100%" Foreground="#0A84FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Slider Row -->
                            <Slider x:Name="ScaleSlider" Style="{StaticResource CupertinoSlider}"
                                    Minimum="80" Maximum="130" Value="100" Margin="52,0,14,12" ValueChanged="ScaleSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Масштабує всі віджети, обкладинки альбомів та шрифт SF Pro Rounded." Foreground="#636366" FontSize="11.5" Margin="14,0,14,18"/>

                    <!-- ══════════ SECTION 4: ОФОРМЛЕННЯ ══════════ -->
                    <TextBlock Text="ОФОРМЛЕННЯ" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="14,0,14,6"/>
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Row 1: Theme -->
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Indigo Squircle Moon -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#5E5CE6" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Тема" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- iOS Segmented Control -->
                                <Border Grid.Column="2" Background="#121214" CornerRadius="8" Padding="2">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="ThemeDarkRadio" Content="Темна" Style="{StaticResource SegmentedRadioButton}" IsChecked="True" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeLightRadio" Content="Світла" Style="{StaticResource SegmentedRadioButton}" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeSystemRadio" Content="Авто" Style="{StaticResource SegmentedRadioButton}" Checked="Theme_Checked"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="0.5" Background="#2C2C2E" Margin="52,0,0,0"/>

                            <!-- Row 2: Accent Colors -->
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Pink Squircle Palette -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#FF375F" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.28 19.64 10.59 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-4.5 9c-.83 0-1.5-.67-1.5-1.5S6.67 9 7.5 9s1.5.67 1.5 1.5S8.33 12 7.5 12zm3-4c-.83 0-1.5-.67-1.5-1.5S9.67 5 10.5 5s1.5.67 1.5 1.5S11.33 8 10.5 8zm3 0c-.83 0-1.5-.67-1.5-1.5S12.67 5 13.5 5s1.5.67 1.5 1.5S14.33 8 13.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Акцентний колір" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- 5 Apple Color Dots -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="26" Margin="0,0,8,0" Tag="#0A84FF" Click="AccentColor_Click">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#0A84FF" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="0,0,8,0" Tag="#30D158" Click="AccentColor_Click">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#30D158" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="0,0,8,0" Tag="#BF5AF2" Click="AccentColor_Click">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#BF5AF2" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="0,0,8,0" Tag="#FF9F0A" Click="AccentColor_Click">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#FF9F0A" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Tag="#FF453A" Click="AccentColor_Click">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#FF453A" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════ SECTION 5: СИСТЕМА ══════════ -->
                    <TextBlock Text="СИСТЕМА" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="14,0,14,6"/>
                    <Border Background="#1C1C1E" CornerRadius="12" Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Row 1: AutoStart (iOS UISwitch Toggle) -->
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: Green Squircle Power -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#32D74B" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Автозапуск при старті Windows" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- iOS Switch -->
                                <CheckBox x:Name="SettingsAutoStartCheck" Grid.Column="2" Style="{StaticResource CupertinoToggleSwitch}"
                                          Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="0.5" Background="#2C2C2E" Margin="52,0,0,0"/>

